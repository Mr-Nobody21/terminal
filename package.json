{
  "name": "cloud-architecture-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @planner/web run dev",
    "build": "pnpm run typecheck && pnpm --filter @planner/web run build && pnpm run build:backend",
    "lint": "eslint .",
    "test": "vitest --config tooling/config/vitest.config.ts",
    "test:e2e": "playwright test --config tooling/config/playwright.config.ts",
    "check": "pnpm run lint && pnpm test --run && pnpm run test:backend && pnpm run build && pnpm run test:e2e && pnpm run test:packaging && pnpm run test:deployment",
    "desktop": "node tooling/scripts/build/tauri.mjs dev",
    "build:desktop": "node tooling/scripts/build/tauri.mjs package native",
    "build:mac": "pnpm --filter @planner/mac run build",
    "test:desktop": "node tooling/scripts/build/tauri.mjs test",
    "build:windows": "pnpm --filter @planner/windows run build",
    "build:linux": "pnpm --filter @planner/linux run build",
    "test:packaging": "node --test tooling/scripts/packaging/*.test.mjs apps/*/tests/*.test.mjs",
    "test:rust": "node tooling/scripts/build/tauri.mjs rust-test",
    "typecheck": "tsc -p tsconfig.json",
    "build:web": "pnpm run build",
    "preview:web": "pnpm --filter @planner/web run preview",
    "dev:backend": "pnpm --filter @planner/backend run dev",
    "build:backend": "pnpm --filter @planner/backend run build",
    "test:backend": "pnpm --filter @planner/backend test",
    "test:backend:integration": "pnpm --filter @planner/backend run test:integration",
    "audit:dependencies": "pnpm audit --audit-level low",
    "test:deployment": "node --test tooling/scripts/deployment/*.test.mjs",
    "deploy:prepare": "node tooling/scripts/deployment/deploy.mjs prepare",
    "deploy:check": "node tooling/scripts/deployment/deploy.mjs check",
    "deploy:start": "node tooling/scripts/deployment/deploy.mjs start",
    "deploy:migrate": "node tooling/scripts/deployment/deploy.mjs migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@planner/adapters": "workspace:*",
    "@planner/domain": "workspace:*",
    "@planner/ui": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "description": "Local-first cloud architecture planning and deterministic cost estimates",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.0.0 <25"
  }
}
