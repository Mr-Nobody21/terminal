{
  "name": "@planner/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts src/manage.ts src/config.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/manage.ts migrate",
    "seed": "tsx --env-file=.env src/manage.ts seed",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "migrations",
    "assets"
  ]
}
